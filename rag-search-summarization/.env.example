# Copy to .env and add your key. Never commit .env (it is git-ignored).
# Only needed for summaries and for generating evaluation queries; search works without it.
GEMINI_API_KEY=paste-your-key-here
# Comma-separated fallback list: when a model's free daily quota runs out, the next one is used.
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Seconds between LLM calls (free tiers limit requests per minute).
LLM_MIN_INTERVAL=6
