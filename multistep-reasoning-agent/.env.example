# Copy this file to .env and fill in your key. Never commit .env (it is in .gitignore).
LLM_PROVIDER=gemini
GEMINI_API_KEY=paste-your-key-here
# Comma-separated fallback list: if a model's daily free quota runs out (or it is overloaded),
# the client switches to the next one.
GEMINI_MODEL=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Extra plan+execute+verify attempts when verification fails
MAX_RETRIES=2
# Seconds between LLM calls. Free tiers limit requests per minute; 6s = at most 10 calls/minute.
LLM_MIN_INTERVAL=6
